<Window x:Class="HomeTxT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeTxT"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        
        <StackPanel DockPanel.Dock="Top" Height="40" Orientation="Horizontal" >
            <Button x:Name="importButton" Content="Import" Height="25" Width="80" Margin="10,0,0,0" Click="ImportButton_Click" />
            <Button x:Name="saveButton" Content="Save" Height="25" Width="80" Margin="10,0,0,0" Click="SaveButton_Click" />
            <Button x:Name="saveCopyAsButton" Content="Save/Copy as" Height="25" Width="80" Margin="10,0,0,0" Click="SaveCopyAsButton_Click" />

        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="40" LastChildFill="False">
            <TextBlock x:Name="fileIndicator" 
               DockPanel.Dock="Left" 
               Height="20" 
               Margin="10,0,0,0" 
               VerticalAlignment="Center" />

            <TextBlock x:Name="savedToast" 
               DockPanel.Dock="Right"
               Text="✓ Saved!" 
               Foreground="Green" 
               FontWeight="Bold" 
               VerticalAlignment="Center" 
               Margin="0,0,10,0" 
               Opacity="0" />
        </DockPanel>

        <TextBox x:Name="textField" 
                 AcceptsReturn="True" 
                 AcceptsTab="True" 
                 TextWrapping="NoWrap" 
                 HorizontalScrollBarVisibility="Auto" 
                 VerticalScrollBarVisibility="Auto" 
         />
    </DockPanel>
</Window>
